diff --git 1/packages/waffle/fs/checkpoint-probe.ts 2/packages/waffle/fs/checkpoint-probe.ts
new file mode 100644
index 00000000..b22a09fe
--- /dev/null
+++ 2/packages/waffle/fs/checkpoint-probe.ts
@@ -0,0 +1,87 @@
+import type { SharedFilesystemState } from "./shared.js";
+
+type Capture = {
+  snapshot: WeakRef<Uint8Array>;
+  batch?: WeakRef<Uint8Array>;
+  snapshotBytes: number;
+  batchBytes: number;
+  slices: number;
+  sliceBytes: number;
+  digests: number;
+  digestBytes: number;
+  puts: number;
+  putBytes: number;
+  manifestPuts: number;
+  journalJsonBytes: number;
+  key?: string;
+  resident: ReturnType<SharedFilesystemState["resources"]>;
+  liveAtSubmission?: {
+    captureBytes: number;
+    batchBytes: number;
+    preparedChunkBytes: number;
+    residentPoolBytes: number;
+  };
+};
+
+let capture: Capture | undefined;
+
+export function probeCapture(data: Uint8Array, shared: SharedFilesystemState): void {
+  if (data.byteLength !== 64 * 1024 ** 2) return;
+  capture = {
+    snapshot: new WeakRef(data),
+    snapshotBytes: data.byteLength,
+    batchBytes: 0,
+    slices: 0,
+    sliceBytes: 0,
+    digests: 0,
+    digestBytes: 0,
+    puts: 0,
+    putBytes: 0,
+    manifestPuts: 0,
+    journalJsonBytes: 0,
+    resident: shared.resources(),
+  };
+}
+
+export function probeBatch(original: Uint8Array, copy: Uint8Array): void {
+  if (!capture || capture.snapshot.deref() !== original) return;
+  capture.batch = new WeakRef(copy);
+  capture.batchBytes = copy.byteLength;
+}
+
+export function probePreparedChunks(bytes: Uint8Array, chunks: readonly { bytes: Uint8Array }[]): void {
+  if (!capture || capture.batch?.deref() !== bytes) return;
+  // preparePayload returns only after every slice and its SHA-256 completed.
+  capture.slices = chunks.length;
+  capture.sliceBytes = chunks.reduce((sum, chunk) => sum + chunk.bytes.byteLength, 0);
+  capture.digests = chunks.length;
+  capture.digestBytes = capture.sliceBytes;
+}
+
+export function probePut(
+  key: string,
+  chunks: readonly { bytes: Uint8Array }[],
+  tx: IDBTransaction,
+): void {
+  if (!capture || capture.slices !== chunks.length || !capture.slices) return;
+  const sample = capture;
+  sample.puts = chunks.length;
+  sample.putBytes = chunks.reduce((sum, chunk) => sum + chunk.bytes.byteLength, 0);
+  sample.manifestPuts = 1;
+  sample.key = key;
+  sample.liveAtSubmission = {
+    captureBytes: sample.snapshot.deref()?.buffer.byteLength ?? 0,
+    batchBytes: sample.batch?.deref()?.buffer.byteLength ?? 0,
+    preparedChunkBytes: sample.putBytes,
+    residentPoolBytes: sample.resident.poolBytes,
+  };
+  tx.addEventListener("complete", () => {
+    const { snapshot: _snapshot, batch: _batch, ...support } = sample;
+    console.log("CHECKPOINT_PROBE " + JSON.stringify({ ...support, durability: tx.durability }));
+  }, { once: true });
+  capture = undefined;
+}
+
+export function probeJournal(json: string): void {
+  if (capture) capture.journalJsonBytes = new TextEncoder().encode(json).byteLength;
+}
