{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "runtime.ts",
    "build.ts",
    "core",
    "fs",
    "proc",
    "interrupt",
    "browser",
    "tests/interrupt-browser-runner-control.ts",
    "tests/storage-browser-runner.ts"
  ]
}
