{
  "name": "waffle-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/waffle build",
    "test": "bun run --cwd packages/waffle test",
    "test:ci": "bun run --cwd packages/waffle test:ci",
    "check": "bun run --cwd packages/waffle check",
    "quality": "bun run --cwd packages/waffle quality && bun run --cwd site typecheck",
    "size": "bun run --cwd packages/waffle size",
    "build:network": "bun run --cwd packages/waffle build:network",
    "size:network": "bun run --cwd packages/waffle size:network",
    "test:network:rust": "bun run --cwd packages/waffle test:network:rust",
    "pack": "bun run --cwd packages/waffle pack",
    "test:libc": "bun run --cwd packages/waffle test:libc",
    "test:browser": "bun run --cwd packages/waffle test:browser",
    "check:nodenext": "bun run --cwd packages/waffle check:nodenext",
    "check:dom-consumer": "bun run --cwd packages/waffle check:dom-consumer",
    "check:tooling": "bun run --cwd packages/waffle check:tooling",
    "lint": "bun run --cwd packages/waffle lint",
    "format:check": "bun run --cwd packages/waffle format:check",
    "unused": "bun run --cwd packages/waffle unused",
    "duplicates": "bun run --cwd packages/waffle duplicates",
    "pack:check": "bun run --cwd packages/waffle pack:check",
    "prepare:package": "bun run --cwd packages/waffle prepare"
  }
}
