-uucore::bin!(uu_tar);
+// Waffle adapter; parser and archive operations remain upstream uu_tar.
+#[cfg(target_os = "wasi")]
+fn initialize_cwd() -> std::io::Result<()> {
+    #[link(wasm_import_module = "runtime_proc")]
+    unsafe extern "C" {
+        fn cwd(output: *mut u8, capacity: usize) -> i32;
+    }
+    let length = unsafe { cwd(std::ptr::null_mut(), 0) };
+    if length < 0 {
+        return Err(std::io::Error::from_raw_os_error(-length));
+    }
+    if length > 1024 * 1024 {
+        return Err(std::io::Error::other("runtime cwd exceeds process request limit"));
+    }
+    let mut bytes = vec![0; length as usize];
+    if unsafe { cwd(bytes.as_mut_ptr(), bytes.len()) } != length {
+        return Err(std::io::Error::other("runtime cwd changed during startup"));
+    }
+    let path = std::str::from_utf8(&bytes).map_err(std::io::Error::other)?;
+    std::env::set_current_dir(path)
+}
+
+fn main() {
+    #[cfg(target_os = "wasi")]
+    if let Err(error) = initialize_cwd() {
+        eprintln!("tar: cannot initialize runtime cwd: {error}");
+        std::process::exit(2);
+    }
+    std::process::exit(uu_tar::uumain(uucore::args_os()));
+}
