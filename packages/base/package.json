{
  "name": "waffle-base",
  "version": "0.0.0",
  "private": true,
  "description": "The everyday Waffle program families.",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "package-artifacts.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts pack",
    "prepack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts check"
  },
  "dependencies": {
    "waffle-coreutils": "workspace:*",
    "waffle-findutils": "workspace:*",
    "waffle-grep": "workspace:*",
    "waffle-ripgrep": "workspace:*",
    "waffle-sed": "workspace:*"
  },
  "devDependencies": {
    "waffle": "workspace:*"
  },
  "peerDependencies": {
    "waffle": "*"
  },
  "waffleHostInterface": 1
}
