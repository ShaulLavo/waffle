{
  "name": "@waffle-os/base",
  "version": "0.0.0",
  "private": true,
  "description": "The everyday Waffle program families.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaulLavo/waffle.git",
    "directory": "packages/base"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "package-artifacts.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts pack",
    "prepack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts check"
  },
  "dependencies": {
    "@waffle-os/coreutils": "workspace:*",
    "@waffle-os/findutils": "workspace:*",
    "@waffle-os/grep": "workspace:*",
    "@waffle-os/ripgrep": "workspace:*",
    "@waffle-os/sed": "workspace:*"
  },
  "devDependencies": {
    "@waffle-os/runtime": "workspace:*"
  },
  "peerDependencies": {
    "@waffle-os/runtime": "*"
  },
  "waffleHostInterface": 3
}
