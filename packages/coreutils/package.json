{
  "name": "waffle-coreutils",
  "version": "0.0.0",
  "private": true,
  "description": "WASI core utilities for Waffle runtimes.",
  "files": [
    "dist",
    "src",
    "docs",
    "fixtures",
    "scripts",
    "provenance",
    "vendor",
    "crates",
    "tests",
    "README.md",
    "LICENSE",
    "programs.provisional.json",
    "sources.lock.json",
    "package-artifacts.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build-coreutils.ts",
    "test:build-routes": "node --test scripts/test-build-routes.ts && bun test scripts/echo-ci.test.ts",
    "test:native": "cargo test --offline --locked -p waffle-program-support -p waffle-coreutils -p waffle-clear -p waffle-echo",
    "verify:transfer": "node scripts/verify-transfer.ts",
    "pack": "node ../../tools/program-package.ts pack",
    "prepack": "node ../../tools/program-package.ts check",
    "notices": "node scripts/notices.ts",
    "prepare:package": "bun run build && bun run notices",
    "build:echo": "node scripts/build-echo.ts",
    "test:echo:wasi": "bun test tests/echo-wasi.test.ts",
    "test:echo:types": "bun ../waffle/node_modules/typescript/bin/tsc -p tests/tsconfig.echo.json"
  },
  "devDependencies": {
    "waffle": "workspace:*"
  },
  "peerDependencies": {
    "waffle": "*"
  }
}
