    "path": "crates/checksums/patches/selected-io-and-escaped-records.patch",
    "sha256": "0eb78cf7dab8d1d8a00727a948dbd6ec38ee60142d1a09c100c6579c25ec3a1b",
    "preparation": "scripts/prepare-checksum-source.ts",
    "generatedSource": ".sources/checksums",
    "changes": [
      "Use selected raw WASI fd_read/fd_write operations instead of Rust stdio wrappers that hide absent descriptors. Named-file-only reads never touch fd0, and output-free verification never touches fd1.",
      "Propagate verification report write errors. Preserve existing streaming buffers and process cancellation.",
      "Strip the optional escape marker before untagged digest parsing, decode marked filenames once, and preserve unmarked filename bytes."
    ]
