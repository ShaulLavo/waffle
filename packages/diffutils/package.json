{
  "name": "@waffle-os/diffutils",
  "version": "0.0.0",
  "private": true,
  "description": "GNU diff and cmp WASI programs for Waffle runtimes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaulLavo/waffle.git",
    "directory": "packages/diffutils"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "scripts",
    "licenses",
    "patches",
    "tests",
    "README.md",
    "LICENSE",
    "LICENSE.gnu",
    "sources.lock.json",
    "tsconfig.json",
    "package-artifacts.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build-diffutils.ts",
    "test": "node scripts/test-diffutils.ts",
    "native-oracle": "node scripts/build-native-oracle.ts",
    "test:wasi": "bun test tests/diffutils-wasi.test.ts",
    "test:source": "node --test scripts/gnu-source.test.ts tests/command-deadline.test.ts",
    "typecheck": "tsc -p .",
    "pack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts pack",
    "prepack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts check",
    "notices": "node scripts/notices.ts",
    "prepare:package": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@waffle-os/runtime": "workspace:*",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@waffle-os/runtime": "*"
  },
  "waffleHostInterface": 3
}
