{
  "listen": {
    "host": "0.0.0.0",
    "port": 8787
  },
  "allowedOrigins": ["https://waffle-network.sprockt.dev"],
  "tcp": {
    "destinations": [{ "host": "example.com", "port": 80 }],
    "limits": {
      "maxConnections": 16,
      "maxConnectionsPerSubject": 4,
      "attemptsPerMinute": 12,
      "maxSubjects": 128,
      "maxOpenBytes": 8192,
      "headerTimeoutMs": 3000,
      "connectTimeoutMs": 5000,
      "idleTimeoutMs": 60000,
      "windowBytes": 65536
    }
  }
}
