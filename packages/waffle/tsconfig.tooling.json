{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "prepare.ts",
    "build.ts",
    "scripts/**/*.ts",
    "tooling/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.js",
    "core/memory-views.js"
  ]
}
