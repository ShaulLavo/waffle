    "build": "bun build.ts",
    "prepare": "bun prepare.ts",
    "test": "bun test ./tests",
    "test:ci": "bun test ./tooling/ci-paths.test.ts",
    "test:libc": "bun scripts/test-wasi-libc.ts",
    "test:browser": "bun scripts/test-browser.ts",
    "check": "tsc -p .",
    "size": "bun tooling/runtime-size.ts",
    "check:nodenext": "tsc -p tsconfig.nodenext.json",
    "check:dom-consumer": "tsc -p tsconfig.dom-consumer.json",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:tooling": "tsc -p tsconfig.tooling.json",
    "check:source": "bun test tooling/typescript-source.test.ts && bun tooling/typescript-source.ts",
    "unused": "knip --no-progress",
    "duplicates": "jscpd --fail-on-new-clones 0",
    "quality": "bun run check:source && bun run lint && bun run format:check && bun run check && bun run check:nodenext && bun run check:dom-consumer && bun run check:tooling && bun run unused && bun run duplicates && bun tooling/quality-probes.ts",
    "build:network": "bun tooling/build-network.ts",
    "size:network": "bun tooling/network-size.ts",
    "test:network:rust": "cargo test --release -p waffle-tcp --features module-tests --locked",
    "pack": "bun pm pack --destination dist",
    "pack:check": "bun tooling/tarball-smoke.ts"
  },
