{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "runtime.ts",
    "build.ts",
    "tooling",
    "core",
    "fs",
    "proc",
    "interrupt",
    "link",
    "programs",
    "browser",
    "tests/interrupt-browser-runner-control.ts",
    "tests/process-recycling-browser-runner.ts",
    "tests/process-recycling-browser-runner.test.ts",
    "tests/storage-browser-runner.ts",
    "tests/storage-lock-browser-runner.ts",
    "tests/storage-lock-browser.ts",
    "tests/storage-lock-recovery-worker.ts",
    "tests/storage-open-worker.ts",
    "tests/browser-filesystem-cancel.test.ts",
    "scripts/test-wasi-libc.ts",
    "tests/wasi-libc.test.ts",
    "tests/wasm-start-section.test.ts",
    "tests/preopen-placement.test.ts",
    "tests/inherited-fd-review.test.ts",
    "tests/libc-tooling.test.ts",
    "tests/fixtures/preopen-node-host.ts",
    "tests/fixtures/start-failure-public.ts"
  ]
}
