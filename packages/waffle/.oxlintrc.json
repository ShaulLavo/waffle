{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error",
    "no-duplicate-imports": "error",
    "import/no-cycle": "error",
    "complexity": [
      "error",
      {
        "max": 30,
        "variant": "modified"
      }
    ],
    "max-nested-callbacks": ["error", 3],
    "max-depth": ["error", 3],
    "no-restricted-globals": [
      "error",
      {
        "name": "name",
        "message": "Use an explicit local name, not the browser worker/window global."
      }
    ],
    "no-nested-ternary": "error",
    "no-else-return": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.astro/**",
    "**/.wrangler/**",
    "site/src/scripts/waffle-scene.ts"
  ],
  "overrides": [
    {
      "files": ["interrupt/rewriter-internal.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 72,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["browser/worker.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 70,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["fs/backend.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 55,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["core/wasi.ts", "proc/worker-client.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 45,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["proc/directory.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 44,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["fs/service.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 41,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["fs/indexeddb.ts", "proc/supervisor.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 40,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["browser/process-broker.ts", "fs/opfs.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 38,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["proc/abi.ts", "proc/pipes.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 36,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": ["proc/worker-access.ts"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 31,
            "variant": "modified"
          }
        ]
      }
    },
    {
      "files": [
        "browser/process-broker.ts",
        "fs/client.ts",
        "proc/abi.ts",
        "proc/directory.ts",
        "proc/pipes.ts",
        "proc/supervisor.ts",
