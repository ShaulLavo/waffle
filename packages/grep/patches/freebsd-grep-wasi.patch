+static int
+grep_regexec(const regex_t *preg, const char *str, size_t nmatch,
+    regmatch_t pmatch[], int leflags)
+{
+	size_t start, end, pos;
+
+	start = (size_t)pmatch[0].rm_so;
+	end = (size_t)pmatch[0].rm_eo;
+	if (start > end)
+		return (REG_NOMATCH);
+	pos = start;
+	while (pos <= end) {
+		const char *seg = str + pos;
+		size_t seglen = strlen(seg);
+		int seg_flags = leflags;
+		int rc;
+
+		if (pos + seglen > end)
+			seglen = end - pos;
+		if (pos > start)
+			seg_flags |= REG_NOTBOL;
+		if (pos + seglen < end)
+			seg_flags |= REG_NOTEOL;
+		rc = regexec(preg, seg, nmatch, pmatch, seg_flags);
+		if (rc == 0) {
+			for (size_t k = 0; k < nmatch; k++) {
+				if (pmatch[k].rm_so >= 0)
+					pmatch[k].rm_so += (regoff_t)pos;
+				if (pmatch[k].rm_eo >= 0)
+					pmatch[k].rm_eo += (regoff_t)pos;
+			}
+			return (0);
+		}
+		if (rc != REG_NOMATCH)
+			return (rc);
+		if (pos + seglen >= end)
+			break;
+		pos += seglen + 1;
+	}
+	return (REG_NOMATCH);
+}
