+static size_t
+decode_unit(const char *s, size_t len, wchar_t *out_wc, bool *out_valid)
+{
+	unsigned char b = (unsigned char)s[0];
+
+	if (b < 0x80) {
+		*out_wc = (wchar_t)b;
+		*out_valid = true;
+		return (1);
+	}
+	mbstate_t st;
+	memset(&st, 0, sizeof(st));
+	size_t n = mbrtowc(out_wc, s, len, &st);
+	if (n == (size_t)-1 || n == (size_t)-2 || n == 0) {
+		*out_wc = (wchar_t)b;
+		*out_valid = false;
+		return (1);
+	}
+	*out_valid = true;
+	return (n);
+}
+
+static bool
+match_icase_mb(const char *str, size_t str_len, size_t start,
+    const char *pat, size_t pat_len, size_t *out_end)
+{
+	size_t sp = start, pp = 0;
+
+	while (pp < pat_len) {
+		wchar_t swc, pwc;
+		bool sv, pv;
+		size_t sstep, pstep;
+
+		if (sp >= str_len)
+			return (false);
+		sstep = decode_unit(str + sp, str_len - sp, &swc, &sv);
+		pstep = decode_unit(pat + pp, pat_len - pp, &pwc, &pv);
+		if (sv && pv) {
+			if (swc != pwc &&
+			    towupper((wint_t)swc) != towupper((wint_t)pwc))
+				return (false);
+		} else if (sv != pv || swc != pwc) {
+			return (false);
+		}
+		sp += sstep;
+		pp += pstep;
+	}
+	*out_end = sp;
+	return (true);
+}
+
+static bool
+match_icase_ascii(const char *str, size_t start, const char *pat, size_t pat_len)
+{
+	for (size_t k = 0; k < pat_len; k++) {
+		if (tolower((unsigned char)str[start + k]) !=
+		    tolower((unsigned char)pat[k]))
+			return (false);
+	}
+	return (true);
+}
