+static bool
+is_literal_pattern(const char *pat, int len, int mode)
+{
+	if (mode == GREP_FIXED)
+		return (true);
+	for (int i = 0; i < len; i++) {
+		char ch = pat[i];
+		if (ch == '\\' || ch == '.' || ch == '[' || ch == '*' ||
+		    ch == '^' || ch == '$')
+			return (false);
+		if (mode == GREP_EXTENDED && (ch == '+' || ch == '?' ||
+		    ch == '(' || ch == ')' || ch == '{' || ch == '}' ||
+		    ch == '|'))
+			return (false);
+	}
+	return (true);
+}
+
+static bool
+is_ere_literal_alternation(const char *pat, int len)
+{
+	bool has_pipe = false;
+	int seg_len = 0;
+
+	for (int i = 0; i < len; i++) {
+		char ch = pat[i];
+		if (ch == '|') {
+			if (seg_len == 0)
+				return (false);
+			has_pipe = true;
+			seg_len = 0;
+			continue;
+		}
+		if (ch == '\\' || ch == '.' || ch == '[' || ch == '*' ||
+		    ch == '^' || ch == '$' || ch == '+' || ch == '?' ||
+		    ch == '(' || ch == ')' || ch == '{' || ch == '}')
+			return (false);
+		seg_len++;
+	}
+	return (has_pipe && seg_len > 0);
+}
