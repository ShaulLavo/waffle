{
  "name": "@waffle-os/grep",
  "version": "0.0.0",
  "private": true,
  "description": "FreeBSD grep (BSD-2-Clause) as a WASI program for Waffle runtimes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaulLavo/waffle.git",
    "directory": "packages/grep"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "scripts",
    "patches",
    "provenance",
    "licenses",
    "tests",
    "README.md",
    "LICENSE",
    "sources.lock.json",
    "build-recipe.json",
    "package-artifacts.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build-grep.ts",
    "build:native": "node scripts/build-grep.ts --native",
    "test": "bun test tests/grep-wasi.test.ts",
    "test:wasi": "bun test tests/grep-wasi.test.ts",
    "test:build-route": "node --test scripts/test-build-route.ts",
    "pack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts pack",
    "prepack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts check",
    "notices": "node scripts/notices.ts",
    "prepare:package": "bun run build && bun run notices"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@waffle-os/runtime": "workspace:*"
  },
  "peerDependencies": {
    "@waffle-os/runtime": "*"
  },
  "waffleHostInterface": 3
}
