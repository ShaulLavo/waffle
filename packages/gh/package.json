{
  "name": "waffle-gh",
  "version": "0.0.0",
  "private": true,
  "description": "Common noninteractive GitHub CLI workflows for Waffle runtimes.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "docs",
    "scripts",
    "fixtures",
    "tests",
    "README.md",
    "LICENSE",
    "NOTICE",
    "sources.lock.json",
    "tsconfig.json",
    "package-artifacts.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/program.ts",
    "./program": "./src/program.ts"
  },
  "scripts": {
    "build": "node scripts/build-gh.ts && node scripts/size.ts",
    "test": "node scripts/build-gh.ts && node --test tests/*.test.ts && node tests/fixtures.ts && node scripts/compare-native.ts && bun test ./tests/program-runtime.ts",
    "test:fixtures": "node tests/fixtures.ts",
    "test:native": "node scripts/compare-native.ts",
    "test:runtime": "bun test ./tests/program-runtime.ts",
    "typecheck": "tsc -p .",
    "pack": "node ../../tools/program-package.ts pack",
    "prepack": "node ../../tools/program-package.ts check",
    "prepare:package": "node scripts/build-gh.ts && node scripts/size.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "waffle": "workspace:*"
  },
  "peerDependencies": {
    "waffle": "*"
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
