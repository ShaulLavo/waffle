{
  "name": "@waffle/python",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "assets",
    "scripts",
    "docs",
    "patches",
    "third-party",
    "README.md",
    "LICENSE",
    "provenance",
    "package-artifacts.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./payload": "./src/python-payload.ts",
    "./install": "./src/install.ts",
    "./launcher": "./src/launcher.ts"
  },
  "scripts": {
    "build": "node scripts/build-python.ts",
    "stage:assets": "node scripts/stage-assets.ts",
    "test:build": "node --test scripts/test-python-build.ts",
    "test:unit": "node --test tests/*.unit.ts",
    "test:node": "node test/runtime.ts",
    "typecheck": "tsc -p .",
    "pack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts pack",
    "test:composition": "node --test scripts/test-waffle-source.ts tests/python-launcher.test.ts scripts/test-stage-assets.ts",
    "prepack": "bun ../../tools/waffle-family-metadata.ts --package . && node ../../tools/program-package.ts check",
    "prepare:package": "node scripts/stage-assets.ts",
    "test:browser": "bun test/browser.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "waffle": "workspace:*"
  },
  "peerDependencies": {
    "waffle": "*"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "waffleHostInterface": 1
}
