{
  "name": "@waffle/python",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "assets",
    "scripts",
    "docs",
    "patches",
    "third-party",
    "README.md",
    "LICENSE",
    "provenance"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./payload": "./src/python-payload.ts"
  },
  "scripts": {
    "build": "node scripts/build-python.ts",
    "stage:assets": "node scripts/stage-assets.ts",
    "test:build": "node --test scripts/test-python-build.ts",
    "test:unit": "node --test tests/*.unit.ts",
    "test:node": "node test/runtime.ts",
    "typecheck": "tsc -p .",
    "pack": "bun pm pack --destination .build"
  },
  "peerDependencies": {
    "waffle": "*"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "dependencies": {
    "waffle": "workspace:*"
  },
  "devDependencies": {
    "waffle": "workspace:*"
  }
}
