+
+#[cfg(target_os = "wasi")]
+fn validate_wasi_options(low: &mut LowArgs) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        low.threads.unwrap_or(1) <= 1,
+        "WASI supports only one search thread; use --threads 1"
+    );
+    anyhow::ensure!(
+        !matches!(low.mmap, MmapMode::AlwaysTryMmap),
+        "WASI does not support --mmap; use --no-mmap"
+    );
+    anyhow::ensure!(
+        low.pre.is_none(),
+        "WASI does not support --pre subprocesses"
+    );
+    anyhow::ensure!(
+        !low.search_zip,
+        "WASI does not support --search-zip subprocesses"
+    );
+    anyhow::ensure!(
+        low.hostname_bin.is_none(),
+        "WASI does not support --hostname-bin subprocesses"
+    );
+    low.threads = Some(1);
+    low.mmap = MmapMode::Never;
+    Ok(())
+}
