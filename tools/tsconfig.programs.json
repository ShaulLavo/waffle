{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "typeRoots": ["../packages/waffle/node_modules/@types", "../packages/git/node_modules/@types"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "program-locales/**/*.ts",
    "../packages/base/src",
    "../packages/coreutils/src/index.ts",
    "../packages/coreutils/scripts/notices.ts",
    "../packages/coreutils/scripts/verify-transfer.ts",
    "../packages/findutils/src/index.ts",
    "../packages/grep/src/index.ts",
    "../packages/gh/src",
    "../packages/sed/src/index.ts",
    "../packages/ripgrep/src/index.ts",
    "../packages/python/src",
    "../packages/jq/src",
    "../packages/jq/scripts",
    "../packages/jq/tests"
  ]
}
