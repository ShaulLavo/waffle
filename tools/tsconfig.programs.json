{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "typeRoots": ["../packages/waffle/node_modules/@types", "../packages/git/node_modules/@types"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "program-locales/**/*.ts",
    "../packages/base/src",
    "../packages/coreutils/src/index.ts",
    "../packages/coreutils/scripts/notices.ts",
    "../packages/coreutils/scripts/verify-transfer.ts",
    "../packages/coreutils/tests/nl-wasi.test.ts",
    "../packages/coreutils/scripts/build-nl.ts",
    "../packages/coreutils/scripts/nl-oracle.ts",
    "../packages/coreutils/scripts/nl-source.test.ts",
    "../packages/coreutils/fixtures/nl-cases.ts",
    "../packages/findutils/src/index.ts",
    "../packages/grep/src/index.ts",
    "../packages/gh/src",
    "../packages/sed/src/index.ts",
    "../packages/ripgrep/src/index.ts",
    "../packages/python/src",
    "../packages/awk/src",
    "../packages/awk/scripts",
    "../packages/awk/tests",
    "../packages/procps/src",
    "../packages/procps/scripts",
    "../packages/procps/tests",
    "../packages/diffutils/src",
    "../packages/diffutils/scripts",
    "../packages/diffutils/tests",
    "../packages/jq/src",
    "../packages/jq/scripts",
    "../packages/jq/tests",
    "../packages/tar/src",
    "../packages/tar/scripts",
    "../packages/tar/tests",
    "../packages/coreutils/tests/date-wasi.test.ts",
    "../packages/coreutils/scripts/build-date.ts",
    "../packages/coreutils/scripts/date-oracle.ts",
    "../packages/coreutils/scripts/date-source.test.ts",
    "../packages/coreutils/fixtures/date-cases.ts"
  ]
}
