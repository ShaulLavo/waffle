{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waffle-site",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "waffle.shaulavo.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
