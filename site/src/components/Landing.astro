---
import bricolageUrl from '../assets/bricolage-grotesque.woff2?url';
import fredokaUrl from '../assets/fredoka.woff2?url';
import martianMonoUrl from '../assets/martian-mono.woff2?url';
import { initialState, interpolateStyle, renderValues } from '../scripts/landing';

interface Props {
  heroPreview?: 'waffle' | 'grid' | 'loop';
  labels?: boolean;
}
const { heroPreview = 'waffle', labels = true } = Astro.props;
const values = renderValues(initialState);
const fontStyles = `
@font-face {
  font-family: 'Bricolage Grotesque';
  font-style: normal;
  font-weight: 400 800;
  font-stretch: 75% 100%;
  font-display: swap;
  src: url("${bricolageUrl}") format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Fredoka';
  font-style: normal;
  font-weight: 500 700;
  font-stretch: 100%;
  font-display: swap;
  src: url("${fredokaUrl}") format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Martian Mono';
  font-style: normal;
  font-weight: 400 700;
  font-stretch: 75% 112.5%;
  font-display: swap;
  src: url("${martianMonoUrl}") format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
`;
---
<style is:inline set:html={fontStyles}></style>

<style is:global>
body{margin:0;background:#F4F6FC}
a{color:#2350C7}a:hover{color:#171B33}
.wbtn{transition:transform .12s ease, box-shadow .12s ease}
.wbtn:hover{transform:translateY(2px);box-shadow:0 3px 0 #171B33 !important}
.wtile{transition:transform .14s ease}
.wtile:hover{transform:translateY(-4px)}
a:focus-visible{outline:3px solid #F7C564;outline-offset:3px}
[data-waffle-if][hidden]{display:none!important}
</style>

<div data-waffle-landing data-hero-preview={heroPreview} data-labels={String(labels)} style="font-family: 'Bricolage Grotesque', system-ui, sans-serif; color: #171B33; background: #F4F6FC; min-width: 0; overflow-x: clip">

  <div style="position: sticky; top: 0; height: 0; z-index: 30">
    <nav aria-label="Main" data-waffle-style="position: absolute; top: 14px; left: 16px; right: 16px; display: flex; justify-content: center; transition: opacity 0.35s ease, transform 0.35s ease, visibility 0.35s; {{navStyle}}" style={interpolateStyle("position: absolute; top: 14px; left: 16px; right: 16px; display: flex; justify-content: center; transition: opacity 0.35s ease, transform 0.35s ease, visibility 0.35s; {{navStyle}}", values)}>
      <div style="width: 100%; max-width: 1240px; display: flex; align-items: center; justify-content: space-between; gap: 16px">
        <a href="#top" aria-label="Waffle home" data-waffle-style="display: flex; align-items: center; text-decoration: none; padding: 2px 4px 6px; transition: opacity 0.3s ease, transform 0.3s ease; {{logoStyle}}" style={interpolateStyle("display: flex; align-items: center; text-decoration: none; padding: 2px 4px 6px; transition: opacity 0.3s ease, transform 0.3s ease; {{logoStyle}}", values)}>
          <span style="font-family: 'Fredoka', 'Arial Rounded MT Bold', system-ui, sans-serif; font-weight: 700; font-size: 32px; line-height: 1; letter-spacing: -0.01em; color: #FFC94D; -webkit-text-stroke: 5px #2A1F33; paint-order: stroke fill; text-shadow: 0 3px 0 #2A1F33">waffle</span>
        </a>
        <div style="display: flex; align-items: center; gap: 8px">
          <div data-waffle-if="wide" hidden={!values.wide} style="display: flex; align-items: center; gap: 8px">
              <a href="#how" class="wbtn" style="display: inline-flex; align-items: center; min-height: 40px; padding: 0 15px; background: #FFFFFF; color: #171B33; border: 2px solid #171B33; border-radius: 999px; box-shadow: 0 3px 0 #171B33; font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap">How it works</a>
              <a href="#today" class="wbtn" style="display: inline-flex; align-items: center; min-height: 40px; padding: 0 15px; background: #FFFFFF; color: #171B33; border: 2px solid #171B33; border-radius: 999px; box-shadow: 0 3px 0 #171B33; font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap">Bash Web</a>
              <a href="#today" class="wbtn" style="display: inline-flex; align-items: center; min-height: 40px; padding: 0 15px; background: #FFFFFF; color: #171B33; border: 2px solid #171B33; border-radius: 999px; box-shadow: 0 3px 0 #171B33; font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap">Bun</a>
              <a href="#" class="wbtn" style="display: inline-flex; align-items: center; min-height: 40px; padding: 0 15px; background: #FFFFFF; color: #171B33; border: 2px solid #171B33; border-radius: 999px; box-shadow: 0 3px 0 #171B33; font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap">GitHub</a>
            </div>

          <a href="#docs" class="wbtn" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; background: #FFC94D; color: #171B33; border: 2.5px solid #171B33; border-radius: 999px; box-shadow: 0 4px 0 #171B33; font-weight: 800; font-size: 16px; text-decoration: none">Docs</a>
        </div>
      </div>
    </nav>
  </div>

  <section id="top" data-scrolly="1" aria-label="Waffle, explained in one scroll" data-waffle-style="position: relative; height: {{scrollyH}}px" style={interpolateStyle("position: relative; height: {{scrollyH}}px", values)}>
    <div data-waffle-style="position: sticky; top: 0; height: {{stageH}}px; overflow: hidden; background: {{stageBg}}" style={interpolateStyle("position: sticky; top: 0; height: {{stageH}}px; overflow: hidden; background: {{stageBg}}", values)}>
      <canvas data-waffle-canvas="1" aria-label="A grid of connected programs tilts into a 3D waffle, with each program sitting in a pocket" role="img" data-waffle-style="position: absolute; left: 0; right: 0; top: {{canvasTop}}px; width: 100%; height: {{canvasH}}; display: block; touch-action: pan-y; opacity: {{canvasO}}; -webkit-mask-image: {{canvasMask}}; mask-image: {{canvasMask}}" style={interpolateStyle("position: absolute; left: 0; right: 0; top: {{canvasTop}}px; width: 100%; height: {{canvasH}}; display: block; touch-action: pan-y; opacity: {{canvasO}}; -webkit-mask-image: {{canvasMask}}; mask-image: {{canvasMask}}", values)}></canvas>

      <div data-waffle-style="position: absolute; {{beatBox}}" style={interpolateStyle("position: absolute; {{beatBox}}", values)}>
        <div data-waffle-style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; gap: {{b0Gap}}; {{b0}}" style={interpolateStyle("position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; gap: {{b0Gap}}; {{b0}}", values)}>
          <div style="display: flex; align-items: center; gap: 10px; font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 13px; color: #DCE6FF; letter-spacing: 0.02em">
            <span style="display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #F7C564"></span>
            <span>Waffle · a WebAssembly runtime for the browser</span>
          </div>
          <h1 data-waffle-style="margin: 0; font-size: {{h1Size}}; line-height: 0.93; letter-spacing: -0.035em; font-weight: 800; font-stretch: 82%; color: #FFFFFF; text-wrap: balance" style={interpolateStyle("margin: 0; font-size: {{h1Size}}; line-height: 0.93; letter-spacing: -0.035em; font-weight: 800; font-stretch: 82%; color: #FFFFFF; text-wrap: balance", values)}>Whole programs, running <span style="color: #F7C564">together,</span> in a browser tab.</h1>
          <p data-waffle-style="margin: 0; max-width: 34em; font-size: {{leadSize}}; line-height: 1.5; color: #E3EAFF; text-wrap: pretty" style={interpolateStyle("margin: 0; max-width: 34em; font-size: {{leadSize}}; line-height: 1.5; color: #E3EAFF; text-wrap: pretty", values)}>Waffle is a WebAssembly (Wasm) runtime that lets programs run, and work with each other, entirely inside the browser.<span data-waffle-style="display: {{leadTail}}" style={interpolateStyle("display: {{leadTail}}", values)}> Our shell, Bash Web, and our browser build of Bun already run on it.</span></p>
          <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px">
            <a href="#docs" class="wbtn" data-waffle-style="display: inline-flex; align-items: center; justify-content: center; flex: {{btnFlex}}; gap: 10px; min-height: 52px; padding: 0 {{btnPad}}; background: #F3B451; color: #171B33; border: 2.5px solid #171B33; border-radius: 16px; font-weight: 800; font-size: 18px; text-decoration: none; box-shadow: 0 5px 0 #171B33" style={interpolateStyle("display: inline-flex; align-items: center; justify-content: center; flex: {{btnFlex}}; gap: 10px; min-height: 52px; padding: 0 {{btnPad}}; background: #F3B451; color: #171B33; border: 2.5px solid #171B33; border-radius: 16px; font-weight: 800; font-size: 18px; text-decoration: none; box-shadow: 0 5px 0 #171B33", values)}>Read the docs <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" data-waffle-style="display: {{arrowD}}" style={interpolateStyle("display: {{arrowD}}", values)}><path d="M3 9h11M10 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
            <a href="#today" data-waffle-style="display: inline-flex; align-items: center; justify-content: center; flex: {{btnFlex}}; min-height: 52px; padding: 0 {{btnPad}}; color: #FFFFFF; border: 2.5px solid rgba(255,255,255,0.75); border-radius: 16px; font-weight: 700; font-size: 18px; text-decoration: none" style={interpolateStyle("display: inline-flex; align-items: center; justify-content: center; flex: {{btnFlex}}; min-height: 52px; padding: 0 {{btnPad}}; color: #FFFFFF; border: 2.5px solid rgba(255,255,255,0.75); border-radius: 16px; font-weight: 700; font-size: 18px; text-decoration: none", values)}>Try Bash Web</a>
          </div>
          <div data-waffle-if="scrollCue" hidden={!values.scrollCue} style="display: flex; align-items: center; gap: 10px; padding-top: 18px; font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 12px; color: #C4D2FF">
              <svg width="16" height="22" viewBox="0 0 16 22" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="19" rx="6.5" fill="none" stroke="currentColor" stroke-width="2"></rect><circle cx="8" cy={values.wheelY} data-wheel-dot="1" r="2" fill="currentColor"></circle></svg>
              <span>Scroll. Watch the diagram.</span>
            </div>

        </div>

        <div data-waffle-style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; {{b1}}" style={interpolateStyle("position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; {{b1}}", values)}>
          <div data-waffle-style="max-width: 440px; background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 22px; box-shadow: 0 6px 0 #171B33; padding: {{cardPad}}; display: flex; flex-direction: column; gap: 10px" style={interpolateStyle("max-width: 440px; background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 22px; box-shadow: 0 6px 0 #171B33; padding: {{cardPad}}; display: flex; flex-direction: column; gap: 10px", values)}>
            <div style="font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 12px; color: #2350C7; letter-spacing: 0.04em">01 · THE GRID</div>
            <h2 style="margin: 0; font-size: clamp(28px, 2.6vw, 38px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 800; font-stretch: 85%">Each square is a program.</h2>
            <p data-waffle-style="margin: 0; font-size: {{cardBody}}; line-height: 1.5; color: #3A3F5C" style={interpolateStyle("margin: 0; font-size: {{cardBody}}; line-height: 1.5; color: #3A3F5C", values)}>An agent writing code. A dev server. A database taking queries, a test suite, a game server, a video job. Each one runs on its own.</p>
          </div>
        </div>

        <div data-waffle-style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; {{b2}}" style={interpolateStyle("position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; {{b2}}", values)}>
          <div data-waffle-style="max-width: 440px; background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 22px; box-shadow: 0 6px 0 #171B33; padding: {{cardPad}}; display: flex; flex-direction: column; gap: 10px" style={interpolateStyle("max-width: 440px; background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 22px; box-shadow: 0 6px 0 #171B33; padding: {{cardPad}}; display: flex; flex-direction: column; gap: 10px", values)}>
            <div style="font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 12px; color: #2350C7; letter-spacing: 0.04em">02 · THE LINES</div>
            <h2 style="margin: 0; font-size: clamp(28px, 2.6vw, 38px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 800; font-stretch: 85%">The lines are how they talk.</h2>
            <p data-waffle-style="margin: 0; font-size: {{cardBody}}; line-height: 1.5; color: #3A3F5C" style={interpolateStyle("margin: 0; font-size: {{cardBody}}; line-height: 1.5; color: #3A3F5C", values)}>One program’s output is another’s input. The shell hands work to Bun, Bun refreshes the preview, the game server writes to the database.</p>
          </div>
        </div>

        <div data-waffle-style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; {{b3}}" style={interpolateStyle("position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; {{b3}}", values)}>
          <div data-waffle-style="max-width: 440px; background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 22px; box-shadow: 0 6px 0 #171B33; padding: {{cardPad}}; display: flex; flex-direction: column; gap: 10px" style={interpolateStyle("max-width: 440px; background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 22px; box-shadow: 0 6px 0 #171B33; padding: {{cardPad}}; display: flex; flex-direction: column; gap: 10px", values)}>
            <div style="font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 12px; color: #2350C7; letter-spacing: 0.04em">03 · THE DEPTH</div>
            <h2 style="margin: 0; font-size: clamp(28px, 2.6vw, 38px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 800; font-stretch: 85%">Every program gets a pocket.</h2>
            <p data-waffle-style="margin: 0; font-size: {{cardBody}}; line-height: 1.5; color: #3A3F5C" style={interpolateStyle("margin: 0; font-size: {{cardBody}}; line-height: 1.5; color: #3A3F5C", values)}>Walls keep each one in its own space. The structure between them carries the traffic. All of it inside one tab.</p>
          </div>
        </div>

        <div data-waffle-style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; gap: 18px; {{b4}}" style={interpolateStyle("position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: {{beatAlign}}; gap: 18px; {{b4}}", values)}>
          <div aria-label="waffle" style="display: flex; font-family: 'Fredoka', 'Arial Rounded MT Bold', system-ui, sans-serif; font-weight: 700; font-size: clamp(76px, 10vw, 172px); line-height: 0.9; letter-spacing: -0.01em; color: #FFC94D; -webkit-text-stroke: 0.06em #2A1F33; paint-order: stroke fill; text-shadow: 0 0.06em 0 #2A1F33">
            <span aria-hidden="true" data-waffle-letter="0" style={"display: inline-block; " + values.letters[0].style}>w</span>
<span aria-hidden="true" data-waffle-letter="1" style={"display: inline-block; " + values.letters[1].style}>a</span>
<span aria-hidden="true" data-waffle-letter="2" style={"display: inline-block; " + values.letters[2].style}>f</span>
<span aria-hidden="true" data-waffle-letter="3" style={"display: inline-block; " + values.letters[3].style}>f</span>
<span aria-hidden="true" data-waffle-letter="4" style={"display: inline-block; " + values.letters[4].style}>l</span>
<span aria-hidden="true" data-waffle-letter="5" style={"display: inline-block; " + values.letters[5].style}>e</span>
          </div>
          <p style="margin: 0; max-width: 26em; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.45; color: #2B3052; text-wrap: pretty">A WebAssembly runtime for programs that run, and work together, in the browser.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 12px">
            <a href="#docs" class="wbtn" data-waffle-style="display: inline-flex; align-items: center; justify-content: center; flex: {{btnFlex}}; gap: 10px; min-height: 52px; padding: 0 {{btnPad}}; background: #F3B451; color: #171B33; border: 2.5px solid #171B33; border-radius: 16px; font-weight: 800; font-size: 18px; text-decoration: none; box-shadow: 0 5px 0 #171B33" style={interpolateStyle("display: inline-flex; align-items: center; justify-content: center; flex: {{btnFlex}}; gap: 10px; min-height: 52px; padding: 0 {{btnPad}}; background: #F3B451; color: #171B33; border: 2.5px solid #171B33; border-radius: 16px; font-weight: 800; font-size: 18px; text-decoration: none; box-shadow: 0 5px 0 #171B33", values)}>Read the docs</a>
            <a href="#today" data-waffle-style="display: inline-flex; align-items: center; justify-content: center; flex: {{btnFlex}}; min-height: 52px; padding: 0 {{btnPad}}; color: #171B33; background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 16px; font-weight: 700; font-size: 18px; text-decoration: none" style={interpolateStyle("display: inline-flex; align-items: center; justify-content: center; flex: {{btnFlex}}; min-height: 52px; padding: 0 {{btnPad}}; color: #171B33; background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 16px; font-weight: 700; font-size: 18px; text-decoration: none", values)}>What runs today</a>
          </div>
          <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 12px; color: #171b33"><span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; background: rgb(243, 180, 81); border: 2px solid rgb(23, 27, 51); border-radius: 999px; font-weight: 700; color: rgb(23, 27, 51)"><span style="width: 7px; height: 7px; border-radius: 50%; background: rgb(23, 27, 51)"></span>Bash Web</span><span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border: 2px solid rgb(23, 27, 51); border-radius: 999px; font-weight: 700; color: rgb(23, 27, 51); background-color: #FFE3EA"><span style="width: 7px; height: 7px; border-radius: 50%; background: rgb(23, 27, 51)"></span>Bun wasm</span>
            <span><br></span>
          </div>
        </div>
      </div>



      <div aria-hidden="true" data-waffle-style="position: absolute; left: 0; right: 0; bottom: 0; height: 180px; pointer-events: none; background: {{stageFade}}" style={interpolateStyle("position: absolute; left: 0; right: 0; bottom: 0; height: 180px; pointer-events: none; background: {{stageFade}}", values)}></div>

      <div data-waffle-if="noGl" hidden={!values.noGl} style="position: absolute; right: 24px; bottom: 24px; max-width: 320px; padding: 14px 16px; background: #FFFFFF; border: 2px solid #171B33; border-radius: 14px; font-size: 14px; line-height: 1.4">The 3D scene needs WebGL, which this browser has turned off. Everything else on the page works.</div>

    </div>
  </section>

  <section id="today" style="padding: clamp(80px, 9vw, 140px) 20px; background: #F4F6FC">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 48px">
      <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px">
        <div style="display: flex; flex-direction: column; gap: 14px; max-width: 720px">
          <div style="font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 13px; color: #2350C7; letter-spacing: 0.04em">RUNNING ON WAFFLE TODAY</div>
          <h2 style="margin: 0; font-size: clamp(40px, 5.2vw, 76px); line-height: 0.95; letter-spacing: -0.04em; font-weight: 800; font-stretch: 82%; text-wrap: balance">Two programs are already in the pockets.</h2>
        </div>
        <p style="margin: 0; max-width: 24em; font-size: 18px; line-height: 1.5; color: #3A3F5C">Our shell and our browser build of Bun are built on Waffle. Open one and you are running on it.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: 28px">
        <article style="background: #FFFFFF; border: 2.5px solid #171B33; border-radius: 28px; box-shadow: 0 8px 0 #171B33; overflow: hidden; display: flex; flex-direction: column">
          <div style="background: #0D1B16; padding: 26px 28px; min-height: 150px; box-sizing: border-box; font-family: 'Martian Mono', ui-monospace, Menlo, monospace; font-size: 15px; line-height: 1.9; color: #3FD69A; display: flex; flex-direction: column; justify-content: flex-end">
            <div style="display: flex; gap: 7px; margin-bottom: auto"><span style="width: 11px; height: 11px; border-radius: 50%; background: #FF6B57"></span><span style="width: 11px; height: 11px; border-radius: 50%; background: #FFD23F"></span><span style="width: 11px; height: 11px; border-radius: 50%; background: #3FD69A"></span></div>
            <div>$ echo "hello from a tab"</div>
            <div style="color: #A8F0CF">hello from a tab</div>
            <div>$ <span style="display: inline-block; width: 10px; height: 18px; background: #3FD69A; vertical-align: -3px"></span></div>
          </div>
          <div style="padding: 28px; display: flex; flex-direction: column; gap: 14px; flex: 1">
            <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 12px">
              <h3 style="margin: 0; font-size: 38px; line-height: 1; letter-spacing: -0.035em; font-weight: 800; font-stretch: 85%">Bash Web</h3>
