---
import Home from "../components/Home.astro";
import Page from "../layouts/Page.astro";

const title = "Waffle: a kernel running in a browser tab";
const description =
  "Waffle gives WebAssembly programs processes, pipes, a shared filesystem and a loopback network, inside one browser tab.";
---

<Page
  title={title}
  description={description}
  canonical="https://waffle.shaulavo.dev/"
  preload={["text", "display", "mono"]}
>
  <Home />
</Page>
